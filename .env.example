# 服务端口
PORT=3000

# 强制沙盒模式：true / false（即使配置了密钥也可强制走沙盒；银行卡通道用）
SANDBOX_MODE=true

# ---- v18：NOWPayments 通道（稳定币） ----
# 架构：商户用「自己的 NOWPayments 账号」在商户门户绑定 API Key + IPN Secret，
# 建单/验签都用各商户自己的密钥。平台侧不需要全局 NOWPayments 密钥。
#
# NOWPAYMENTS_MOCK=true：单元测试/联调时用内存模拟 NOWPayments 真实接口
# （建单返回模拟地址、IPN 用自签回调），不联网、不花钱。
# 正式运行必须注释掉或设为 false。
NOWPAYMENTS_MOCK=

# 商户凭证加密密钥（64 位十六进制，AES-256-GCM）。
# 正式运行必须配置一个长期固定的值；不配置则每次启动用临时密钥，
# 重启后已绑定的商户密钥无法解密（需重新绑定）。
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRED_ENC_KEY=

# ---- Payoneer 通道（银行卡，占位：战略上待 Antom 接入后替换） ----
# Payoneer Checkout 的 merchant code 与 payment token（Basic 认证用）。
# 留空则 Payoneer 通道自动进入沙盒模拟模式。
PAYONEER_MERCHANT_CODE=
PAYONEER_PAYMENT_TOKEN=
# Payoneer 后台的 division（商户分组，建收银台时透传，可选）
PAYONEER_DIVISION=

# ---- v21：找回密码邮件（Resend） ----
# RESEND_API_KEY：Resend 的 API Key。不设置则只在控制台打印邮件内容、不真发。
# 注意：密钥只用环境变量传入，不要写进任何文件。
RESEND_API_KEY=
# 发件人。jirvs.com 已在 Resend 验证通过，默认即可。
MAIL_FROM=Jirvs <noreply@jirvs.com>

# ---- 合规：IP 地理围栏（默认关闭，不影响本地测试；生产环境开启）----
GEO_FENCE_ENABLED=false
GEO_BLOCKED_COUNTRIES=CN
# 测试时允许用请求头模拟国家（仅测试用，生产不要开）
# ALLOW_TEST_GEO_HEADER=true

# 对外基础地址（开户链接回跳、NOWPayments IPN 回调用；不填则自动取请求 host）
# 注意：NOWPayments IPN 必须能公网访问到本服务，本地 localhost 收不到回调，
# 真实小额测试前请把服务部署到公网 HTTPS 地址，并在这里填公网地址。
# BASE_URL=https://pay.example.com

# ---- v21.6：总后台首个超级管理员 ----
# admins 表为空时，启动会自动用这两个环境变量创建首个超级管理员（只此一次）。
# 密码绝不写进代码或文件，只走环境变量。创建后建议在总后台再添加其他管理员。
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
