# =============================================================================
# Jirvs 环境变量样例（提交到 Git；真实值请在 .env 里覆盖，.env 已 .gitignore）
# 复制本文件为 .env，然后填入真实值即可生效：
#   cp .env.example .env   (macOS / Linux)
#   copy .env.example .env (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)
# =============================================================================

# ---------- 服务 ----------
# HTTP 端口（默认 3000）
PORT=3000
# 对外可访问的根地址（用于构造邮件里的重置链接、回调地址等）
BASE_URL=http://localhost:3000
# SQLite 数据库文件路径（默认 ./data/jirvs.db，目录需存在）
DB_PATH=./data/jirvs.db

# ---------- 邮件（Resend） ----------
# Resend API Key，未配置则只打印到控制台不发邮件
RESEND_API_KEY=
# 发件人地址，格式必须是 DisplayName <addr@domain>
# 测试发件人 onboarding@resend.dev 只能发给注册 Resend 的那个邮箱
MAIL_FROM=Jirvs <noreply@yourdomain.com>

# ---------- 支付通道 ----------
# Stripe Connect + Checkout（sk_test_ 开发测试，sk_live_ 生产）
STRIPE_SECRET_KEY=
# Stripe Dashboard Webhook endpoint secret（whsec_...）
STRIPE_WEBHOOK_SECRET=
# Stripe API v2 版本；默认使用 Accounts v2 当前预览版本
STRIPE_API_VERSION=2026-08-26.preview
# Stripe Connect OAuth 平台 Client ID（test/live 必须与 STRIPE_SECRET_KEY 同环境）
STRIPE_CLIENT_ID=
# Stripe OAuth 回调地址；生产环境必须是 Stripe Dashboard 已登记的固定 HTTPS URL
STRIPE_OAUTH_REDIRECT_URL=
# 旧版 Connect 回跳配置（OAuth 流程不再使用）
STRIPE_CONNECT_RETURN_URL=
# 已有 Stripe 账号授权（OAuth）用的测试/生产 client_id（ca_...）；不填则只支持新账号开户
STRIPE_CONNECT_OAUTH_CLIENT_ID=
# OAuth 回调地址；留空则使用 BASE_URL/api/v1/stripe/oauth/callback
STRIPE_CONNECT_OAUTH_REDIRECT_URI=

# NOWPayments（稳定币接口预留）
NOWPAYMENTS_API_BASE=https://api.nowpayments.io/v1
# 内存模拟（true=本地单测；false=走真实接口）
NOWPAYMENTS_MOCK=true

# 加密商户敏感字段（如 IPN Secret）的 32 字节 hex key
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRED_ENC_KEY=

# 订阅支付 Webhook 签名密钥
SUBSCRIPTION_WEBHOOK_SECRET=

# ---------- 合规 / 地理围栏 ----------
# 是否启用地理围栏（true/false），默认关闭
GEO_FENCE_ENABLED=false
# 被屏蔽的国家/地区代码，逗号分隔（ISO 3166-1 alpha-2）
GEO_BLOCKED_COUNTRIES=CN
# 是否允许通过 X-Test-Country 请求头绕过围栏（仅本地调试）
ALLOW_TEST_GEO_HEADER=false

# ---------- 首个超级管理员（首次启动自动创建，留空则跳过） ----------
# 邮箱统一小写存储；密码会被哈希，不会以明文落库
ADMIN_EMAIL=
ADMIN_PASSWORD=
